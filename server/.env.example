# Copy this file to  server/.env  and fill in your keys.
# server/.env is ignored by git, so your keys are never uploaded to GitHub.

# Ali's brain. Needed. Get a key at https://console.anthropic.com
# (This is separate from a Claude.ai subscription.)
ANTHROPIC_API_KEY=

# Ali's voice. Optional; without it the page uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# The voice to use: open the voice in ElevenLabs and copy its "Voice ID".
ELEVENLABS_VOICE_ID=

# Ali's ears (so people can speak instead of typing). Optional.
# With an ElevenLabs key this works already. To use OpenAI Whisper instead,
# add the key below and set STT_PROVIDER=openai
OPENAI_API_KEY=
# STT_PROVIDER=openai

# Recommended while testing: a code people must enter before Ali will talk,
# so strangers cannot spend your credits.
ACCESS_CODE=

# The websites allowed to use this server, separated by commas.
ALLOWED_ORIGINS=https://haiderlse.github.io

# Optional settings
# PORT=8787
# DAILY_LIMIT=600
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# ELEVENLABS_TTS_MODEL=
# ELEVENLABS_STT_MODEL=scribe_v2
# OPENAI_STT_MODEL=whisper-1
